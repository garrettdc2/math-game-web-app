{
  "name": "openclaw-factory",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate-settings": "tsx scripts/generate-agent-settings.ts",
    "predev": "npm run generate-settings",
    "dev:server": "PORT=8001 tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "docker:up": "docker compose up -d openclaw",
    "docker:down": "docker compose down",
    "start:dev": "npm run docker:up && npm run dev",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.39.0",
    "dotenv": "^16.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0",
    "motion": "^12.6.0",
    "lucide-react": "^0.475.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "sonner": "^2.0.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/ws": "^8.5.0"
  }
}
