# Anthropic — powers all Claude Code agent sessions (REQUIRED)
ANTHROPIC_API_KEY=

# GitHub — branches, PRs, code reviews (OPTIONAL — omit for local git repos)
GITHUB_TOKEN=
GITHUB_ORG=varsitytutors

# Netlify — frontend deploy target (OPTIONAL — omit to serve apps locally)
NETLIFY_TOKEN=
NETLIFY_TEAM_SLUG=nerdyinc

# Supabase — database and backend (OPTIONAL — omit for local SQLite)
SUPABASE_TOKEN=

# OpenClaw — agent orchestration gateway
OPENCLAW_BASE_URL=http://localhost:18789
OPENCLAW_HOOK_TOKEN=factory-webhook-secret

# Local demo mode — when GITHUB_TOKEN, NETLIFY_TOKEN, or SUPABASE_TOKEN are
# absent, the factory falls back to local alternatives automatically:
#   - No GITHUB_TOKEN  → local git repos in workspaces/
#   - No NETLIFY_TOKEN  → apps built and served locally on auto-assigned ports
#   - No SUPABASE_TOKEN → apps use local SQLite instead of Supabase
# Only ANTHROPIC_API_KEY is required. Mix and match as needed.
